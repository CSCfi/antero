        "measures": [
          {
            "name": "Kyselyn kohteet (Rahoitus)",
            "expression": [
              "",
              "var summa =  SUM('Lukumaarat ja kertoimet'[kyselyn_kohteet_rahoitus])",
              "return IF(summa=0,BLANK(),summa)",
              ""
            ],
            "formatString": "#,0"
          },
          {
            "name": "Kyselyn kohteet (Arvo)",
            "expression": [
              "",
              "SUM('Lukumaarat ja kertoimet'[kyselyn_kohteet_arvo])"
            ],
            "formatString": "#,0"
          },
          {
            "name": "Kyselyn kohteet (OPH)",
            "expression": [
              "",
              "var summa =  SUM('Lukumaarat ja kertoimet'[kyselyn_kohteet_vahvistettu])",
              "return IF(summa=0,BLANK(),summa)"
            ],
            "formatString": "#,0"
          },
          {
            "name": "Vastanneet (OPH)",
            "expression": [
              "",
              "SUM('Lukumaarat ja kertoimet'[vastanneet_vahvistettu])"
            ],
            "formatString": "#,0"
          },
          {
            "name": "Vastanneet (Rahoitus)",
            "expression": [
              "",
              "var summa = SUM('Lukumaarat ja kertoimet'[vastanneet_rahoitus])",
              "return IF(summa=0,BLANK(),summa)"
            ],
            "formatString": "#,0"
          },
          {
            "name": "Vastausosuus (OPH)",
            "expression": "DIVIDE([Vastanneet (OPH)],[Kyselyn kohteet (OPH)])",
            "formatString": "0 %;-0 %;0 %"
          },
          {
            "name": "Vastausosuus (Rahoitus)",
            "expression": "DIVIDE([Vastanneet (Rahoitus)],[Kyselyn kohteet (Rahoitus)])",
            "formatString": "0 %;-0 %;0 %"
          },
          {
            "name": "Korjauskerroin (Arvo)",
            "expression": [
              "",
              "CALCULATE(AVERAGE('Lukumaarat ja kertoimet'[katokorjauskerroin_arvo]),VALUES(Muuttujat[Kyselyn kohderyhmä]))"
            ],
            "formatString": "0.00"
          },
          {
            "name": "Korjauskerroin (Rahoitus)",
            "expression": [
              "",
              "CALCULATE(AVERAGE('Lukumaarat ja kertoimet'[katokorjauskerroin_rahoitus]),VALUES(Muuttujat[Kyselyn kohderyhmä]))"
            ],
            "formatString": "0.00"
          },
          {
            "name": "Pisteet (Arvo)",
            "expression": "CALCULATE(SUM(Muuttujat[numerovalinta_summa]))",
            "formatString": "#,0"
          },
          {
            "name": "Pisteet (Rahoitus)",
            "expression": [
              "",
              "--CALCULATE(IF([Vastanneet (Arvo)] > [Vastanneet (OPH)]; [Pisteet (Arvo)] * DIVIDE([Vastanneet (OPH)];[Vastanneet (Arvo)]);[Pisteet (Arvo)]))",
              "var taulu = CALCULATETABLE(Muuttujat,VALUES(Muuttujat[Kyselyn kohderyhmä]))",
              "return SUMX(taulu, [numerovalinta_summa] * DIVIDE([Vastanneet (Rahoitus)],[Vastanneet (Arvo)]))"
            ],
            "formatString": "#,0"
          },
          {
            "name": "Painotetut pisteet (Arvo)",
            "expression": [
              "",
              "var taulu = CALCULATETABLE('Lukumaarat ja kertoimet',VALUES(Muuttujat[Kyselyn kohderyhmä]))",
              "return SUMX(taulu, [kerroin] * [Pisteet (Arvo)] * [katokorjauskerroin_arvo])"
            ],
            "formatString": "#,0"
          },
          {
            "name": "Painotetut pisteet (Rahoitus)",
            "expression": [
              "",
              "var taulu = CALCULATETABLE('Lukumaarat ja kertoimet',VALUES(Muuttujat[Kyselyn kohderyhmä]))",
              "return SUMX(taulu, [kerroin] * [Pisteet (Rahoitus)] * [katokorjauskerroin_rahoitus])"
            ],
            "formatString": "#,0"
          },
          {
            "name": "Keskiarvo (Rahoitus)",
            "expression": "SUMX(Muuttujat,[keskiarvo]*[Vastanneet (Arvo)]) / SUMX(Muuttujat,[Vastanneet (Arvo)])",
            "formatString": "0.00"
          },
          {
            "name": "Painotetut pisteet % (Arvo)",
            "expression": [
              "DIVIDE([Painotetut pisteet (Arvo)],CALCULATE([Painotetut pisteet (Arvo)],ALLEXCEPT(Muuttujat,Muuttujat[Kyselyn kohderyhmä],Muuttujat[Rahoituskausi],Muuttujat[Varainhoitovuosi])))",
              ""
            ],
            "formatString": "#,0.00 %;-#,0.00 %;#,0.00 %"
          },
          {
            "name": "Painotetut pisteet % (Rahoitus)",
            "expression": [
              "",
              "CALCULATE(",
              "\tDIVIDE(",
              "\t\t[Painotetut pisteet (Rahoitus)],",
              "\t\tCALCULATE([Painotetut pisteet (Rahoitus)],ALLEXCEPT(Muuttujat,Muuttujat[Kyselyn kohderyhmä],Muuttujat[Kysely],Muuttujat[Rahoituskausi],Muuttujat[Varainhoitovuosi]))",
              "\t)",
              ")"
            ],
            "formatString": "0.00 %;-0.00 %;0.00 %"
          },
          {
            "name": "Vastaajamäärä (Rahoitus)",
            "expression": [
              "",
              "var lkm = DISTINCTCOUNT('Lukumaarat ja kertoimet'[vastaajamaaran_lahde])",
              "return IF(lkm>1,BLANK(),FIRSTNONBLANK('Lukumaarat ja kertoimet'[vastaajamaaran_lahde],TRUE()))"
            ]
          },
          {
            "name": "Vastanneet (Arvo)",
            "expression": [
              "",
              "SUM('Lukumaarat ja kertoimet'[vastanneet_arvo])"
            ],
            "formatString": "#,0"
          },
          {
            "name": "Vastausosuus (Arvo)",
            "expression": "DIVIDE([Vastanneet (Arvo)],[Kyselyn kohteet (Arvo)])",
            "formatString": "0 %;-0 %;0 %"
          }
        ],
