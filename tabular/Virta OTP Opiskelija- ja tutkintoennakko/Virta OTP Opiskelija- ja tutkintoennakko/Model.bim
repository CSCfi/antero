              "                SUM(Muuttujat[opiskelijat2]),",
              "                KEEPFILTERS(Muuttujat[apurahas] <= EARLIER(Muuttujat[apurahas])),",
              "       \t Muuttujat[apurahas] > 0",
              "            )",
              "        )",
              "    )                                           ",
              "return",
