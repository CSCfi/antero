          {
            "name": "Opintopisteiden mediaani (tutkinnon suorittaneet)",
            "expression": [
              "",
              "",
              " var __nbrows = SUM(Muuttujat[tutkinnot2])",
              " var __isod=if(__nbrows/2>int(__nbrows/2),1,0)",
              " var __n=if(__nbrows/2>int(__nbrows/2),int(__nbrows/2)+1,int(__nbrows/2))",
              " var __list= ",
              " \tCALCULATETABLE(ADDCOLUMNS(",
              "                   \tSUMMARIZE(Muuttujat,Muuttujat[op_yhteensa]),",
              "                                           \"cml\",calculate(SUM(Muuttujat[tutkinnot2]),",
              "                                          Muuttujat[op_yhteensa]   <= EARLIER(Muuttujat[op_yhteensa]) ",
              "                                             )",
              "                        ),Muuttujat[tutkinnot2] > 0)                                         ",
              "return",
              "IF([Tutkinnot_s] < 5, BLANK(), if(__isod=1,",
              "    minx(FILTER(__list,[cml]>=__n),[op_yhteensa]),",
              "    0.5*(minx(FILTER(__list,[cml]>=__n),[op_yhteensa])+minx(FILTER(__list,[cml]>=__n+1),[op_yhteensa]))))"
            ],
            "formatString": "#,0"
          },
          {
            "name": "Opintopisteiden mediaani (tutkinnon suorittaneet)_s",
            "expression": [
              "",
              "",
              " var __nbrows = SUM(Muuttujat[tutkinnot2])",
              " var __isod=if(__nbrows/2>int(__nbrows/2),1,0)",
              " var __n=if(__nbrows/2>int(__nbrows/2),int(__nbrows/2)+1,int(__nbrows/2))",
              " var __list= ",
              " \tCALCULATETABLE(ADDCOLUMNS(",
              "                   \tSUMMARIZE(Muuttujat,Muuttujat[op_yhteensa]),",
              "                                           \"cml\",calculate(SUM(Muuttujat[tutkinnot2]),",
              "                                          Muuttujat[op_yhteensa]   <= EARLIER(Muuttujat[op_yhteensa]) ",
              "                                             )",
              "                        ),Muuttujat[tutkinnot2] > 0)                                         ",
              "return",
              "if(__isod=1,",
              "    minx(FILTER(__list,[cml]>=__n),[op_yhteensa]),",
              "    0.5*(minx(FILTER(__list,[cml]>=__n),[op_yhteensa])+minx(FILTER(__list,[cml]>=__n+1),[op_yhteensa])))",
              ""
            ],
            "formatString": "#,0"
          },
          {
            "name": "Ensikertaiset aloittajat",
            "expression": [
              "",
              "",
              "var lkm = SUM(Muuttujat[ensikertaiset_aloittaneet])",
              "",
              "RETURN",
              "",
