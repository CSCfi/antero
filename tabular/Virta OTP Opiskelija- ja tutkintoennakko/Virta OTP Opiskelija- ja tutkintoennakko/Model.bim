              " var __n=if(__nbrows*0.5>int(__nbrows*0.5),int(__nbrows*0.5)+1,int(__nbrows*0.5))",
              "var __list =",
              "    CALCULATETABLE(",
              "        ADDCOLUMNS(",
              "            SUMMARIZE(Muuttujat, Muuttujat[apurahas]),",
              "            \"cml\",",
