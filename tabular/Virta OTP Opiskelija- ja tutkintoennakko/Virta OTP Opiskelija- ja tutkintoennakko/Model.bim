            ],
            "formatString": "#,0",
            "displayFolder": "Lukuvuosimaksut"
          },
          {
            "name": "Apuraha kevät: Keskiarvo (euroa)",
            "expression": [
              "",
              "",
              "var lkm = CALCULATE(SUM(Muuttujat[opiskelijat2]), Muuttujat[apurahak] > 0)",
              "",
              "RETURN",
              "",
              "IF([Opiskelijat_s] < 5, BLANK(), SUMX(Muuttujat, Muuttujat[apurahak] * Muuttujat[opiskelijat2]) / lkm)"
            ],
            "formatString": "#,0",
            "displayFolder": "Lukuvuosimaksut"
          },
          {
            "name": "Apuraha kevät: Keskiarvo (euroa)_s",
            "expression": [
              "",
              "",
              "var lkm = CALCULATE(SUM(Muuttujat[opiskelijat2]), Muuttujat[apurahak] > 0)",
              "",
              "RETURN",
              "",
              "SUMX(Muuttujat, Muuttujat[apurahak] * Muuttujat[opiskelijat2]) / lkm"
            ],
            "formatString": "#,0",
            "displayFolder": "Lukuvuosimaksut"
          },
          {
            "name": "Apuraha syksy: Mediaani (euroa)",
            "expression": [
              "",
              "",
              " var __nbrows = CALCULATE(SUM(Muuttujat[opiskelijat2]), Muuttujat[apurahas] > 0)",
              " ",
              " var __isod=if(__nbrows*0.5>int(__nbrows*0.5),1,0)",
              " var __n=if(__nbrows*0.5>int(__nbrows*0.5),int(__nbrows*0.5)+1,int(__nbrows*0.5))",
              "var __list =",
              "    CALCULATETABLE(",
              "        ADDCOLUMNS(",
              "            SUMMARIZE(Muuttujat, Muuttujat[apurahas]),",
              "            \"cml\",",
              "            CALCULATE(",
              "                SUM(Muuttujat[opiskelijat2]),",
              "                KEEPFILTERS(Muuttujat[apurahas] <= EARLIER(Muuttujat[apurahas])),",
              "       \t Muuttujat[apurahas] > 0",
              "            )",
              "        )",
              "    )                                           ",
              "return",
              "IF([Opiskelijat_s] < 5, BLANK(), if(__isod=1,",
              "    minx(FILTER(__list,[cml]>=__n), [apurahas]),",
              "    0.5*(minx(FILTER(__list,[cml]>=__n),[apurahas])+minx(FILTER(__list,[cml]>=__n+1),[apurahas]))))"
            ],
            "formatString": "#,0",
            "displayFolder": "Lukuvuosimaksut"
          },
