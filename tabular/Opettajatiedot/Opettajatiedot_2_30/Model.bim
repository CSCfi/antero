            "name": "Koulutusaste2",
            "dataType": "string",
            "isDataTypeInferred": true,
            "isHidden": true,
            "expression": " Muuttujat[Koulutusaste]"
          }
        ],
        "partitions": [
          {
            "name": "Muuttujat",
            "dataView": "full",
            "source": {
              "type": "query",
              "query": " \t\t\t\tSELECT [dbo].[v_f_tab_opettajat_2_30].*   FROM [dbo].[v_f_tab_opettajat_2_30] ",
              "dataSource": "SqlServer dwitvipusql22 VipunenTK"
            }
          }
        ],
        "measures": [
          {
            "name": "kytkin",
            "expression": "IF(LEFT(USERNAME(), 4) = \"DWI\\\", 1, 0)",
            "isHidden": true
          },
          {
            "name": "Opettajat",
            "expression": [
              " ",
              "var taulu = SUMMARIZE(Muuttujat, [rivinro], [lkm])",
              "var summa = SUMX(taulu, [lkm])",
              "return IF(summa= 0, BLANK(), IF(summa< 5, \"1-4\", MROUND(summa, 3)))"
            ],
            "formatString": "#,0"
          },
          {
            "name": "Opettajat_s",
            "expression": [
              " ",
              "var taulu = SUMMARIZE(Muuttujat, [rivinro], [lkm])",
              "var summa = SUMX(taulu, [lkm])",
              "return IF(summa= 0, BLANK(), IF([kytkin]=0, BLANK(), summa))"
            ],
            "formatString": "#,0"
          },
          {
            "name": "Kelpoisuus tehtävään",
            "expression": [
              " ",
              "var taulu = SUMMARIZE(Muuttujat, [Kelpoisuus tehtävään (hinnoittelutunnus)], [rivinro], [lkm])",
              "var summa = SUMX(Filter(taulu, [Kelpoisuus tehtävään (hinnoittelutunnus)] = \"kelpoinen tehtävään\"), [lkm])",
              "return IF(summa= 0, BLANK(), IF(summa< 5, \"1-4\", MROUND(summa, 3)))"
            ],
            "formatString": "#,0"
          },
          {
            "name": "Kelpoisuus tehtävään (TK)",
            "expression": [
              " ",
              "var taulu = SUMMARIZE(Muuttujat,[Kelpoisuus koulutusasteelle (TK)], [rivinro], [lkm])",
              "var summa = SUMX(Filter(taulu, [Kelpoisuus koulutusasteelle (TK)] = \"Kelpoisuus tehtävään\"), [lkm])",
              "return IF(summa= 0, BLANK(), IF(summa< 5, \"1-4\", MROUND(summa, 3)))"
            ],
            "formatString": "#,0"
          },
          {
            "name": "Ei kelpoisuutta tehtävään",
            "expression": [
              " ",
              "var taulu = SUMMARIZE(Muuttujat, [Kelpoisuus tehtävään (hinnoittelutunnus)], [rivinro], [lkm])",
              "var summa = SUMX(Filter(taulu, [Kelpoisuus tehtävään (hinnoittelutunnus)] = \"ei kelpoisuutta tehtävään\"), [lkm])",
              "return IF(summa= 0, BLANK(), IF(summa< 5, \"1-4\", MROUND(summa, 3)))"
            ],
            "formatString": "#,0"
          },
          {
            "name": "Ei kelpoisuutta tehtävään (TK)",
            "expression": [
              " ",
              "var taulu = SUMMARIZE(Muuttujat,[Kelpoisuus koulutusasteelle (TK)], [rivinro], [lkm])",
              "var summa = SUMX(Filter(taulu, [Kelpoisuus koulutusasteelle (TK)] = \"Ei kelpoisuutta tehtävään\"), [lkm])",
              "return IF(summa= 0, BLANK(), IF(summa< 5, \"1-4\", MROUND(summa, 3)))"
            ],
            "formatString": "#,0"
          },
          {
            "name": "Kelpoisuustieto puuttuu",
            "expression": [
              " ",
              "var taulu = SUMMARIZE(Muuttujat, [Kelpoisuus tehtävään (hinnoittelutunnus)], [rivinro], [lkm])",
              "var summa = SUMX(Filter(taulu, [Kelpoisuus tehtävään (hinnoittelutunnus)] = \"Kelpoisuustieto puuttuu\"), [lkm])",
              "return IF(summa= 0, BLANK(), IF(summa< 5, \"1-4\", MROUND(summa, 3)))"
            ],
            "formatString": "#,0"
          },
          {
            "name": "Kelpoisuustieto puuttuu (TK)",
            "expression": [
              " ",
              "var taulu = SUMMARIZE(Muuttujat,[Kelpoisuus koulutusasteelle (TK)], [rivinro], [lkm])",
              "var summa = SUMX(Filter(taulu, [Kelpoisuus koulutusasteelle (TK)] = \"Kelpoisuustieto puuttuu\"), [lkm])",
              "return IF(summa= 0, BLANK(), IF(summa< 5, \"1-4\", MROUND(summa, 3)))"
            ],
            "formatString": "#,0"
          },
          {
            "name": "Ei kelpoisuustietoa (rehtori)",
            "expression": [
              " ",
              "var taulu = SUMMARIZE(Muuttujat, [Kelpoisuus tehtävään (hinnoittelutunnus)], [rivinro], [lkm])",
              "var summa = SUMX(Filter(taulu, [Kelpoisuus tehtävään (hinnoittelutunnus)] = \"Ei kelpoisuustietoa (rehtori)\"), [lkm])",
              "return IF(summa= 0, BLANK(), IF(summa< 5, \"1-4\", MROUND(summa, 3)))"
            ],
            "formatString": "#,0"
          },
          {
            "name": "Kelpoisten osuus kaikista",
            "expression": [
              "",
              "var osa = [Kelpoisuus tehtävään]",
              "var osa_str = CONVERT(osa, STRING)",
              "var kaikki = [Opettajat]",
              "var kaikki_str = CONVERT(kaikki, STRING)",
              "return IF(osa = BLANK(), BLANK(),",
              "IF(kaikki_str = \"1-4\", \"25 % – 100 %\",",
              "IF(osa_str = \"1-4\", IF(kaikki > 8000, 0,",
              "CONCATENATE(FORMAT(1 / kaikki, \"0.0 % – \"), FORMAT(4 / kaikki, \"0.0 %\"))),",
              "DIVIDE(osa, kaikki))))"
            ],
            "formatString": "0.0 %;-0.0 %;0.0 %"
          },
          {
            "name": "Kelpoisten (TK) osuus kaikista",
            "expression": [
              "",
              "var osa = [Kelpoisuus tehtävään (TK)]",
              "var osa_str = CONVERT(osa, STRING)",
              "var kaikki = [Opettajat]",
              "var kaikki_str = CONVERT(kaikki, STRING)",
              "return IF(osa = BLANK(), BLANK(),",
              "IF(kaikki_str = \"1-4\", \"25 % – 100 %\",",
              "IF(osa_str = \"1-4\", IF(kaikki > 8000, 0,",
              "CONCATENATE(FORMAT(1 / kaikki, \"0.0 % – \"), FORMAT(4 / kaikki, \"0.0 %\"))),",
              "DIVIDE(osa, kaikki))))"
            ],
            "formatString": "0.0 %;-0.0 %;0.0 %"
          }
        ],
